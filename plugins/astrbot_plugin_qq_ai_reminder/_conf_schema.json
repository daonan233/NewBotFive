{
  "enabled": {
    "description": "启用提醒插件",
    "type": "bool",
    "default": true
  },
  "timezone": {
    "description": "提醒时区",
    "type": "string",
    "default": "Asia/Shanghai"
  },
  "poll_interval_seconds": {
    "description": "到期提醒扫描间隔（秒）",
    "type": "int",
    "default": 5,
    "slider": {"min": 2, "max": 60, "step": 1}
  },
  "max_attempts": {
    "description": "发送失败最大尝试次数",
    "type": "int",
    "default": 3,
    "slider": {"min": 1, "max": 10, "step": 1}
  }
}

