# ---------- 镜像与时区 ----------
TZ=Asia/Shanghai
ASTRBOT_IMAGE=soulter/astrbot:latest
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
POSTGRES_IMAGE=pgvector/pgvector:pg17
REDIS_IMAGE=redis:7-alpine

# Linux 宿主机用户 ID；部署前可用 `id -u` 和 `id -g` 查询
NAPCAT_UID=1000
NAPCAT_GID=1000
# 首次启动后请立即修改；不要将真实值提交到 Git
NAPCAT_WEBUI_TOKEN=change-me

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=qq_ai_bot
POSTGRES_USER=qq_ai_bot
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me
REDIS_POOL_MAX_CONNECTIONS=20

# ---------- OpenAI Compatible ----------
# AstrBot WebUI 的 API Key 字段请填写 $OPENAI_API_KEY，而不是复制明文。
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=
DEFAULT_MODEL=replace-me
FAST_MODEL=
SMART_MODEL=
VISION_MODEL=
CODING_MODEL=

# ---------- 权限与限流 ----------
SUPER_USERS=123456789
AI_RATE_LIMIT_PER_MINUTE=10
SEARCH_RATE_LIMIT_PER_MINUTE=5
IMAGE_RATE_LIMIT_PER_MINUTE=2

# ---------- 搜索与图片 ----------
# SEARCH_PROVIDER 可选 tavily 或 serper；SEARCH_API_BASE 通常无需填写
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_API_BASE=
IMAGE_API_BASE=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_RATE_LIMIT_PER_MINUTE=2

# ---------- 本地随机图片 ----------
# Windows 建议使用正斜杠，例如 D:/Pictures/bot-gallery
RANDOM_IMAGE_HOST_DIR=./assets/random_images
